# Create a Discord application at https://discord.com/developers/applications,
# add a bot, then paste its token here. Never commit the real .env file.
DISCORD_TOKEN=replace-me

# Accurate GPU configuration for an NVIDIA card with about 10 GB VRAM or more.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=it

# A sentence is emitted after this much silence from one speaker.
SILENCE_MS=900
MIN_UTTERANCE_MS=450
MAX_UTTERANCE_SECONDS=25
